    "description": "Butir izin internet"
  },
  "privacyPermissionLocation": "Location. QuranKu needs location only when you use GPS for prayer times or qibla. You can use manual city selection instead.",
  "@privacyPermissionLocation": {
    "description": "Butir izin lokasi"
  },
  "privacyPermissionNotifications": "Notifications. QuranKu needs notification permission only when you enable adhan reminders.",
  "@privacyPermissionNotifications": {
    "description": "Butir izin notifikasi"
