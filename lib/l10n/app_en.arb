  "privacyPurposeTitle": "1  Purpose",
  "@privacyPurposeTitle": {
    "description": "Judul bagian 1"
  },
  "privacyPurposeBody": "QuranKu helps you read Al-Quran, listen to murotal, and track prayer times. This policy explains what data QuranKu collects and how QuranKu uses the data.",
  "@privacyPurposeBody": {
    "description": "Isi bagian 1"
  },
  "privacyCollectedTitle": "2  Data that QuranKu collects",
  "@privacyCollectedTitle": {
    "description": "Judul bagian 2"
  },
  "privacyCollectedLocation": "Prayer location. You enter a province and city, or you allow GPS. QuranKu uses the location only to show prayer times and the qibla direction.",
  "@privacyCollectedLocation": {
    "description": "Butir lokasi shalat"
  },
  "privacyCollectedPreferences": "App preferences. QuranKu stores your choices, for example theme, text size, last read position, saved bookmarks, saved asmaul, and saved duas. QuranKu stores these choices on the device.",
  "@privacyCollectedPreferences": {
    "description": "Butir preferensi"
  },
  "privacyCollectedAudio": "Audio and download status. QuranKu tracks which surah files you download so QuranKu can play them offline.",
  "@privacyCollectedAudio": {
    "description": "Butir audio dan unduhan"
  },
  "privacyCollectedUpdate": "App version and update check. When you check for updates, QuranKu sends a request to GitHub to read the latest release tag.",
  "@privacyCollectedUpdate": {
    "description": "Butir pemeriksaan pembaruan"
  },
  "privacyNotCollectedTitle": "3  Data that QuranKu does not collect",
  "@privacyNotCollectedTitle": {
    "description": "Judul bagian 3"
