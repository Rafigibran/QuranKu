    "description": "Butir penjualan data"
  },
  "privacyNotCollectedAds": "QuranKu does not show third-party ads.",
  "@privacyNotCollectedAds": {
    "description": "Butir iklan"
  },
  "privacyPermissionsTitle": "4  Permissions",
